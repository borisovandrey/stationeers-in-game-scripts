#terain-mars\manufacture\smart-store\mn-store-ingot-display.ic10
define MODULExNAME HASH("st-ingot-display")
define MDSPxHASH HASH("ModularDeviceLEDdisplay3")
define REFRESHxTIME 30 #sec
define IDXxADDR 50
define HASHxADDR 100
define DSPxADDR 200
alias Store d0
alias LED d1
alias idx r0
alias hash r1
alias qtty r2
alias occupied r3
alias count r4
alias dspId r5
alias addr r6
alias occupiedSlots r7
alias slot r8
alias total r9
move count 0
move hash HASH("ItemCopperIngot")
move dspId HASH("ing-dsp-copper")
jal initialize
move hash HASH("ItemIronIngot")
move dspId HASH("ing-dsp-iron")
jal initialize
move hash HASH("ItemNickelIngot")
move dspId HASH("ing-dsp-nickel")
jal initialize
move hash HASH("ItemSilverIngot")
move dspId HASH("ing-dsp-silver")
jal initialize
move hash HASH("ItemGoldIngot")
move dspId HASH("ing-dsp-gold")
jal initialize
move hash HASH("ItemLeadIngot")
move dspId HASH("ing-dsp-lead")
jal initialize
move hash HASH("ItemSiliconIngot")
move dspId HASH("ing-dsp-silicon")
jal initialize
move hash HASH("ItemSteelIngot")
move dspId HASH("ing-dsp-steel")
jal initialize
move hash HASH("ItemInvarIngot")
move dspId HASH("ing-dsp-invar")
jal initialize
move hash HASH("ItemConstantanIngot")
move dspId HASH("ing-dsp-constantan")
jal initialize
move hash HASH("ItemElectrumIngot")
move dspId HASH("ing-dsp-electrum")
jal initialize
move hash HASH("ItemSolderIngot")
move dspId HASH("ing-dsp-solder")
jal initialize
move hash HASH("ItemAstroloyIngot")
move dspId HASH("ing-dsp-astroloy")
jal initialize
move hash HASH("ItemInconelIngot")
move dspId HASH("ing-dsp-inconel")
jal initialize
move hash HASH("ItemWaspaloyIngot")
move dspId HASH("ing-dsp-waspaloy")
jal initialize
move hash HASH("ItemHastelloyIngot")
move dspId HASH("ing-dsp-hastelloy")
jal initialize
move hash HASH("ItemStelliteIngot")
move dspId HASH("ing-dsp-stellite")
jal initialize
s LED On 0
s LED Color Color.Gray
main:
    s LED On 1
    jal holdline
    s LED Color Color.Yellow
    yield
    jal clearTotals
    jal collectTotals
    sbn HASH("StructureLogicMemory") HASH("store-mutex") Setting 0 #freeline
    s LED Color Color.Orange
    yield
    jal updateDisplays
    s LED On 0
    s LED Color Color.Gray
    sleep REFRESHxTIME
j main

initialize:
    abs r15 hash
    mod r15 r15 100
    move addr IDXxADDR
    add addr addr count
    put db addr r15
    lbn dspId MDSPxHASH dspId ReferenceId Minimum   
    move addr DSPxADDR
    add addr addr r15
    put db addr dspId 
    add count count 1
j ra

clearTotals:
    move idx 0
clearTotalsLoop:
    beq idx count ra
    move addr IDXxADDR
    add addr addr idx
    get addr db addr
    add addr addr HASHxADDR 
    put db addr 0
    add idx idx 1
j clearTotalsLoop

collectTotals:
    l occupiedSlots Store Quantity
    move slot 2
collectTotalsLoop:
    beqz occupiedSlots ra
    ls occupied Store slot Occupied
    ls qtty Store slot Quantity
    ls hash Store slot OccupantHash
    add slot slot 1
    beqz occupied collectTotalsLoop
    sub occupiedSlots occupiedSlots 1
    abs addr hash
    mod addr addr 100
    add addr addr HASHxADDR
    get total db addr
    add total total qtty
    put db addr total
j collectTotalsLoop

updateDisplays:
    move idx 0
updateDisplaysLoop:
    beq idx count ra
    move addr IDXxADDR
    add addr addr idx
    get hash db addr
    add addr hash HASHxADDR
    get total db addr
    add addr hash DSPxADDR 
    get dspId db addr
    s dspId Setting total
    add idx idx 1
    move r15 Color.Red
    blt total 20 setDisplayColorEnd
    move r15 Color.Yellow
    blt total 100 setDisplayColorEnd
    move r15 Color.Green
    blt total 500 setDisplayColorEnd
    move r15 Color.Blue
setDisplayColorEnd:
    s dspId Color r15
j updateDisplaysLoop

holdline:
    s LED Color Color.Blue
    lbn r15 HASH("StructureLogicMemory") HASH("store-mutex") Setting Minimum
    beq r15 MODULExNAME ra
    brnez r15 2
    sbn HASH("StructureLogicMemory") HASH("store-mutex") Setting MODULExNAME
    sleep 1
j holdline

