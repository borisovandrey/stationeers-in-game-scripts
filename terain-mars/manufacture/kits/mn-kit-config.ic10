alias MEM.PIN   d0
define AUTO     1
define ATMO     2
define ELECTRO  3
define TOOLS    4
alias name r0
alias hash r1
alias qtty r2
alias dev  r3
alias idx  r4
alias Sorter r5
alias Return r6
alias Multiplier r7
alias Return2 r8
alias IDX.HDR r10
alias IDX.REF r11
alias IDX.RGN r12
move IDX.HDR 0
move IDX.REF 200
move IDX.RGN 300
define DEVICES.START 100
define DISPLAY.START 110
define BUTTON.START  120 
clr MEM.PIN
s db Setting 0
jal configConsole

move Multiplier 1
#Start kit configurations
move name STR("LBATTR") 
jal begin
    jal addLargeBattery
jal end
move name STR("TURBIN") 
jal begin
    jal addLargeTurbine
jal end
move name STR("AIRLCK")
jal begin
    jal addAirlock
jal end
move name STR("OUTPST")
jal begin
    jal addOutpost
jal end
move name STR("SILO")
jal begin
    jal addSilo
jal end
move name STR("DEEPMN")
jal begin
    jal addDeepMiner
jal end
move name STR("REPKIT")
jal begin
    jal addReparatureKit
jal end

#Stop kit configurations
jal configurePackageSorter
j finish

addReparatureKit:
    move Return ra
    move hash HASH("CardboardBox")
    move qtty 1
    move dev AUTO
    jal insert
    move hash HASH("ItemSteelFrames")
    move qtty 10
    move dev AUTO
    jal insert
    move hash HASH("ItemSteelSheets")
    move qtty 20
    move dev AUTO
    jal insert
    move hash HASH("ItemPlasticSheets")
    move qtty 20
    move dev AUTO
    jal insert
    move hash HASH("ItemCableCoil")
    move qtty 16
    move dev AUTO
    jal insert
    move hash HASH("ItemKitPipe")
    move qtty 10
    move dev ATMO
    jal insert
    move hash HASH("ItemBatteryCell")
    move qtty 1
    move dev ELECTRO
    jal insert
    move hash HASH("ItemArcWelder")
    move qtty 1
    move dev TOOLS
    jal insert
    move ra Return
j ra

addLargeBattery:
    move Return ra
    move hash HASH("ItemKitBatteryLarge")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemSteelSheets")
    move qtty 4 
    move dev AUTO
    jal insert
    move hash HASH("ItemElectronicParts")
    move qtty 2
    move dev ELECTRO
    jal insert
    move ra Return
j ra

addLargeTurbine:
    move Return ra
    move hash HASH("ItemKitWindTurbine")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemSteelSheets")
    move qtty 5 
    move dev AUTO
    jal insert
    move hash HASH("ItemCableCoil")
    move qtty 5 
    move dev AUTO
    jal insert
    move ra Return
j ra

addSilo:
    move Return ra
    move hash HASH("KitSDBSilo")
    move qtty 1 
    move dev AUTO
    jal insert
    move hash HASH("ItemSteelSheets")
    move qtty 16 
    move dev AUTO
    jal insert
    move hash HASH("ItemPlasticSheets")
    move qtty 10 
    move dev AUTO
    jal insert
    move hash HASH("ItemCableCoil")
    move qtty 6
    move dev AUTO
    jal insert
    move ra Return
j ra

addDeepMiner:
    move Return ra
    move hash HASH("ItemKitDeepMiner")
    move qtty 1 
    move dev AUTO
    jal insert
    move hash HASH("ItemSteelSheets")
    move qtty 12
    move dev AUTO
    jal insert
    move hash HASH("ItemCableCoil")
    move qtty 5 
    move dev AUTO
    jal insert
    move hash HASH("ItemElectronicParts")
    move qtty 4
    move dev ELECTRO
    jal insert
    move ra Return 
j ra

addAirlock:
    move Return ra
    move hash HASH("ItemKitDoor")
    move qtty 2 
    move dev AUTO
    jal insert
    move hash HASH("ItemPlasticSheets")
    move qtty 2 
    move dev AUTO
    jal insert
    move hash HASH("ItemGlassSheets")
    move qtty 6 
    move dev AUTO
    jal insert
    move hash HASH("ItemCableCoil")
    move qtty 50 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemKitConsole")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("CircuitboardAdvAirlockControl")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemKitSensor")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemAreaPowerControl")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemBatteryCellLarge")
    move qtty 1 
    move dev ELECTRO
    jal insert
    move hash HASH("ItemActiveVent")
    move qtty 2 
    move dev ATMO
    jal insert
    move hash HASH("ItemPassiveVentInsulated")
    move qtty 2 
    move dev ATMO
    jal insert
    move hash HASH("ItemKitInsulatedPipe")
    move qtty 10 
    move dev ATMO
    jal insert
    move ra Return
j ra

addOutpost:
    move Return2 ra
    jal addDeepMiner
    move Multiplier 2
    jal addSilo
    move Multiplier 1 
    move hash HASH("ItemIronFrames")
    move qtty 60
    move dev AUTO
    jal insert
    move hash HASH("ItemIronSheets")
    move qtty 60
    move dev AUTO
    jal insert
    move hash HASH("ItemKitCompositeFloorGrating")
    move qtty 50
    move dev AUTO
    jal insert
    move hash HASH("ItemKitRailing")
    move qtty 20
    move dev AUTO
    jal insert
    move hash HASH("ItemKitStairs")
    move qtty 3
    move dev AUTO
    jal insert
    move hash HASH("ItemKitSolarPanelReinforced")
    move qtty 12
    move dev ELECTRO
    jal insert
    move hash HASH("ItemGlassSheets")
    move qtty 60
    move dev AUTO
    jal insert
    move hash HASH("ItemAreaPowerControl")
    move qtty 1
    move dev ELECTRO
    jal insert
    move hash HASH("ItemKitChute")
    move qtty 40
    move dev AUTO
    jal insert
    move hash HASH("ItemWallLight")
    move qtty 1
    move dev ELECTRO
    jal insert
    move hash HASH("ItemCableCoil")
    move qtty 100
    move dev ELECTRO
    jal insert
    move hash HASH("ItemCableCoilHeavy")
    move qtty 100
    move dev ELECTRO
    jal insert
    move hash HASH("ItemKitBattery")
    move qtty 1
    move dev ELECTRO
    jal insert
    move hash HASH("ItemSteelSheets")
    move qtty 2
    move dev AUTO
    jal insert
    move hash HASH("ItemKitLogicCircuit")
    move qtty 2
    move dev ELECTRO
    jal insert
    move hash HASH("ItemIntegratedCircuit10")
    move qtty 2
    move dev ELECTRO
    jal insert
    move hash HASH("ItemKitLogicTransmitter")
    move qtty 2
    move dev ELECTRO
    jal insert
    move hash HASH("ItemKitArcFurnace")
    move qtty 1
    move dev AUTO
    jal insert
    move hash HASH("ItemKitVendingMachineRefrigerated")
    move qtty 1
    move dev ELECTRO
    jal insert
    move hash HASH("ItemPlasticSheets")
    move qtty 2
    move dev AUTO
    jal insert
    move ra Return2
j ra

configurePackageSorter:
    move Sorter $8FF88
    s Sorter Mode 2 # None
    sll r15 HASH("CardboardBox") 8
    or r15 r15 SorterInstruction.FilterPrefabHashEquals
    putd Sorter 0 r15
    sll r15 HASH("CardboardBoxLarge") 8
    or r15 r15 SorterInstruction.FilterPrefabHashEquals
    putd Sorter 1 r15
j ra

begin:
    put MEM.PIN IDX.HDR name    #Store name
    put MEM.PIN IDX.REF IDX.RGN #Store reference to reagents
    add IDX.HDR IDX.HDR 1
    add IDX.REF IDX.REF 1 
j ra
insert:
    mul qtty qtty Multiplier
    sll r15 hash 16
    sll r14 qtty 8
    or r15 r15 r14
    or r15 r15 dev 
    put MEM.PIN IDX.RGN r15
    add IDX.RGN IDX.RGN 1 
j ra
end:
    put MEM.PIN IDX.RGN 0
    add IDX.RGN IDX.RGN 1
j ra
configConsole:
    move idx DEVICES.START
    lbn r15 HASH("StructureAutolathe") HASH("man-al-dev") ReferenceId Minimum
    put MEM.PIN idx r15 #Autolat
    add idx idx 1
    lbn r15 HASH("StructureHydraulicPipeBender") HASH("man-atm-dev") ReferenceId Minimum
    put MEM.PIN idx r15 #Atmo
    add idx idx 1
    lbn r15 HASH("StructureElectronicsPrinter") HASH("man-el-dev") ReferenceId Minimum
    put MEM.PIN idx r15 #Electro
    add idx idx 1
    lbn r15 HASH("StructureToolManufactory") HASH("man-tl-dev") ReferenceId Minimum
    put MEM.PIN idx r15 #Craft
    add idx idx 1
    put MEM.PIN idx 0

    move idx DISPLAY.START
    lbn r15 HASH("ModularDeviceLEDdisplay3") HASH("kit-dsp-1") ReferenceId Minimum
    s r15 On 1
    put MEM.PIN idx r15 #DSP1
    add idx idx 1
    lbn r15 HASH("ModularDeviceLEDdisplay3") HASH("kit-dsp-2") ReferenceId Minimum
    s r15 On 1
    put MEM.PIN idx r15 #DSP2
    add idx idx 1
    lbn r15 HASH("ModularDeviceLEDdisplay3") HASH("kit-dsp-3") ReferenceId Minimum
    s r15 On 1
    put MEM.PIN idx r15 #DSP3
    add idx idx 1
    lbn r15 HASH("ModularDeviceLEDdisplay3") HASH("kit-dsp-4") ReferenceId Minimum
    s r15 On 1
    put MEM.PIN idx r15 #DSP4
    add idx idx 1
    lbn r15 HASH("ModularDeviceLEDdisplay3") HASH("kit-dsp-5") ReferenceId Minimum
    s r15 On 1
    put MEM.PIN idx r15 #DSP5
    add idx idx 1
    put MEM.PIN idx 0

    move idx BUTTON.START
    lbn r15 HASH("ModularDeviceSquareButton") HASH("kit-btn-1") ReferenceId Minimum
    put MEM.PIN idx r15
    add idx idx 1
    lbn r15 HASH("ModularDeviceSquareButton") HASH("kit-btn-2") ReferenceId Minimum
    put MEM.PIN idx r15
    add idx idx 1
    lbn r15 HASH("ModularDeviceSquareButton") HASH("kit-btn-3") ReferenceId Minimum
    put MEM.PIN idx r15
    add idx idx 1
    lbn r15 HASH("ModularDeviceSquareButton") HASH("kit-btn-4") ReferenceId Minimum
    put MEM.PIN idx r15
    add idx idx 1
    lbn r15 HASH("ModularDeviceSquareButton") HASH("kit-btn-5") ReferenceId Minimum
    put MEM.PIN idx r15
    add idx idx 1
    put MEM.PIN idx 0
j ra

finish:
s db Setting 1001
