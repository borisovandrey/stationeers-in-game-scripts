#terain-mars\energy-control\console\groupb-balance-console.ic10
#This script is reponsible for power output display the nerergy balance
#From power sources, batteries and consumption
#init display colors
s $13DCE7 Mode DisplayMode.Power #Input display
s $13DCE7 Color Color.Green
s $13DCEB Mode DisplayMode.Power #Output display
s $13DCEB Color Color.Yellow
s $13DCF0 Mode DisplayMode.Power #Capacity display
s $13DCF0 Color Color.Blue
s $13DD8D Mode DisplayMode.Power #Current balance
s $13DD8D Color Color.Gray
s $13DD92 Mode DisplayMode.Power #Balance full
s $13DD92 Color Color.Gray
s $13DD97 Mode DisplayMode.Power #Balance per tick
s $13DD97 Color Color.Gray
s $13DE03 Mode DisplayMode.Minutes #Cycle
s $13DDBC Color Color.Gray         #Gauge   
#Init battaris data
alias Balance r0
alias WeatherStation r1
alias TimeCounter r2
alias BalanceCurrent r3
alias BalanceStored r4
alias LastStormMemory r5
alias BalancePerTick r6
alias Seconds r7
define STORM 2
move WeatherStation $1FCA3
move TimeCounter $13EA0C
move BalanceCurrent $13EA2C
move BalanceStored $13EA2F
move LastStormMemory $13EA33
define SMBxCONSUMPTION 50# Each battery takes  50
main:
    yield
    jal timerTick
    jal displayBattaries
    s TimeCounter Setting Seconds
j main
timerTick:
    l Seconds TimeCounter Setting
    add Seconds Seconds 0.5
j ra
displayBattaries:
    lbn r15 HASH("StructureBatteryLarge") HASH("bataries-pool-b") Charge Sum
    move r14 $13DCF0 #Store capacity display Ref id
    s r14 Setting r15 #Set capacity display
    lbn r15 HASH("StructureBatteryLarge") HASH("bataries-pool-b") Ratio Average
    #Setup capacity display color
    push ra
    jal setColorbyRatio
    pop ra
    #Define self consumption
    lbn r13 HASH("StructureBatteryLarge") HASH("bataries-pool-b") On Sum
    mul r13 r13 SMBxCONSUMPTION
    l r15 $126003 PowerPotential #Input power
    s $13DCE7 Setting r15 #Set input display
    l r14 $125F0D PowerActual #Output power
    s $13DCEB Setting r14 #Set output display
    #Calculate integral
    l Balance BalanceCurrent Setting
    add Balance Balance r15
    sub Balance Balance r14
    sub Balance Balance r13
    l r15 WeatherStation Mode
    l r14 LastStormMemory Setting
    beq r15 r14 sameCalulationPeriod
    s LastStormMemory Setting r15
    bne r15 STORM sameCalulationPeriod
        s BalanceStored Setting Balance
        s $13DD92 Setting Balance #Set stored integral display
        div r15 Seconds 60
        ceil r15 r15 
        s $13DE03 Setting r15
        div BalancePerTick Balance Seconds
        div BalancePerTick BalancePerTick 2
        s $13DD97 Setting BalancePerTick #Set balance per tick
        move Seconds 0
        sgez r15 Balance
        move Balance 0
        select r15 r15 Color.Blue Color.Red
        s $13DDBC Color r15 #Set gauge collor
        s $13DD92 Color r15 #Set integral display color
        s $13DD97 Color r15 #Set balance per tick
        add BalancePerTick BalancePerTick 1000
        brle BalancePerTick 2000 2
            move BalancePerTick 2000
        brgez BalancePerTick 2
            move BalancePerTick 0
        div BalancePerTick BalancePerTick 2000
        s $13DDBC Setting BalancePerTick
sameCalulationPeriod:
    s $13DD8D Setting Balance #Show current integral
    s BalanceCurrent Setting Balance
j ra
#r15 - ratio, #r14 device id
setColorbyRatio:
    brle r15 0.9 3
        s r14 Color Color.Blue #SMALLxCAPACITYxDISPLAY
        j ra
    brle r15 0.3 3
        s r14 Color Color.Green #SMALLxCAPACITYxDISPLAY
        j ra
    breqz r15 3
        s r14 Color Color.Yellow #SMALLxCAPACITYxDISPLAY
        j ra
    s r14 Color Color.Gray #SMALLxCAPACITYxDISPLAY
j ra