#terain-mars\furnance\arc\auto-furnance\fn-mixer-dial-temperature.ic10
#andreas.peters.de@proton.me 01.05.2026
#This script allows to combine two CO2 sources with different temperature to get the desired result
#This script assumes cold gas is connected to mixer input 1 and hot gas to input 2
#Uses algorithm from https://www.reddit.com/r/Stationeers/comments/lrorc5/from_now_on_we_can_precisely_mix_different_gases/
#S = 100 * C2 * (T0 - T2) * T1 / ( C1 * (T1 - T0) * T2 + C * (T0 - T2) * T1 ) 
#use https://ic10.dev/ for debug

#Let Z be the ratio.
#Gas Mixer takes such amount (n1, in moles) of gas1 that it takes 
# V*Z litres of the output pipe at pressure Pm 101.325kPa (game limit for gas mixer) per second. 
# V is volume of output pipe.
#Then it takes n2 amount of gas2 so that it takes V*(1-Z) litres of the output pipe. 

#Energy of mixing gas is:
#E = C1 * n1 * To + C2 * n2 * To = To * ( C1 * n1 + C2 * n2 ) 

#Some formulas
#P * V = n * R * T - Ideal Gas Law
#E = C * n * T - Internal Energy
#Ppressure, kPa
#Pm = 101.325 kPa - maximum pressure for Gas Mixer, in-game value
#V - volume, litres
#n - amount, moles
#R = 8.3144 - gas constant, is the exact in-game value
#T - temperature, K
#E – energy, J
#C – heat capacity, J / ( moles * K )
#0K = -273.15C

#Heat capacity table:
#Gas 	        CO2 	H2 	    N2 	    N2O 	O2 	    X
#J / (moles*K) 	28.2 	20.4 	20.6 	23 	    21.1 	24.8 

#The result formula for exactly gas mimixg ratio is
#S = 100 * ( T1 * a ) / ( T1 * a + T2 * (1 - a) )
#Where a is the desired ratio

alias Mixer     r0
alias HotSns    r1 #Input 2 of mixer
alias ColdSns   r2 #Input 1 of mixer
alias Display   r3
alias Dial100   r4
alias Dial10    r5
alias SetBtn    r6
alias To        r7

define Klvn     273.15 #Kelvin value for 0C

lbn Mixer HASH("StructureGasMixer") HASH("fn-mixer") ReferenceId Minimum
lbn HotSns HASH("StructurePipeAnalysizer") HASH("fn-hot-sns") ReferenceId Minimum
lbn ColdSns HASH("StructurePipeAnalysizer") HASH("fn-cold-sns") ReferenceId Minimum
lbn Display HASH("ModularDeviceLEDdisplay3") HASH("fn-mixer-temp-dsp") ReferenceId Minimum
lbn Dial100 HASH("ModularDeviceDial") HASH("fn-mixer-dial100") ReferenceId Minimum
lbn Dial10 HASH("ModularDeviceDial") HASH("fn-mixer-dial10") ReferenceId Minimum
lbn SetBtn HASH("ModularDeviceUtilityButton2x2") HASH("fn-mixer-start") ReferenceId Minimum

s Display On 1
s Display Color Color.Red
s Display Mode DisplayMode.Celsius

main:
    yield
    l r15 Dial100 Setting
    l r14 Dial10 Setting
    mul r15 r15 100
    mul r14 r14 10
    add To r15 r14
    s Display Setting To

    l r15 SetBtn Setting 
    beqz r15 main

    l r15 HotSns Temperature   #Th
    l r14 ColdSns Temperature  #Tl
    add To To Klvn
    bgt To r15 setMixerHot
    blt To r14 setMixerCold
    sub r13 r15 To # diff1 = Th - To
    sub r12 To r14 # diff2 = To - Tl
    # diff2 * Th /  ( diff1 * Tl + diff2 * Th )
    mul r11 r13 r14 #diff1 * Tl
    mul r10 r12 r15 #diff2 * Th
    add r10 r10 r11
    beqz r10 setMixerHalf
    mul r11 r12 r15 #diff2 * Th
    div r10 r11 r10
    mul r10 r10 100
    #Mixer Setting controls input 1 percentage, so invert the computed hot/input 2 ratio
    sub r10 100 r10
    s Mixer Setting r10
j main

setMixerHot:
    s Mixer Setting 0
j main

setMixerCold:
    s Mixer Setting 100
j main

setMixerHalf:
    s Mixer Setting 50
j main

